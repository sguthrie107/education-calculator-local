# -------------------------------------------------------
# Local development: SQLite (default, no changes needed)
# -------------------------------------------------------
DATABASE_URL=sqlite:///education.db

# Optional: PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://...

# Security (use a long random string)
SECRET_KEY=change-me

# HTTP Basic Auth passwords. Leaving a password blank disables that account.
AUTH_STEVEN_PASSWORD=
AUTH_ALYSSA_PASSWORD=
AUTH_GUEST_PASSWORD=

# Failed-login hardening
AUTH_MAX_FAILED_ATTEMPTS=8
AUTH_FAILED_WINDOW_SECONDS=300
AUTH_LOCKOUT_SECONDS=900

# Debug mode
DEBUG=false

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:8001
